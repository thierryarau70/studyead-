{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NUXT_PUBLIC_API_URL", "NODE_ENV", "PORT", "DATABASE_URL", "JWT_SECRET"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".next/**", ".vercel/output/**"],
      "env": ["NUXT_PUBLIC_API_URL", "NODE_ENV"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
