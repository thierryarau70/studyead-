{
  "name": "studyead-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:migrate": "npm run --prefix apps/api db:migrate",
    "db:generate": "npm run --prefix apps/api db:generate",
    "db:seed": "npm run --prefix apps/api db:seed",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2"
  },
  "packageManager": "npm@10.9.2"
}
