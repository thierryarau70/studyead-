# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://studyead:localdev@localhost:5432/studyead?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Authentication
JWT_SECRET="dev-super-secret-key-change-in-production-min-32-chars-long"
JWT_EXPIRES_IN="1d"

# Default Tenant (Alpha)
DEFAULT_TENANT_ID="00000000-0000-0000-0000-000000000001"

# Payments (Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Video (Bunny Stream)
BUNNY_API_KEY=""
BUNNY_LIBRARY_ID=""
BUNNY_CDN_HOSTNAME=""
BUNNY_TOKEN_KEY=""

# Storage (S3 / Cloudflare R2)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET="studyead-materials"
STORAGE_PUBLIC_URL=""
